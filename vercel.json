{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "installCommand": "npm install",
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/admin/scrape-news/trigger",
      "schedule": "15 2 * * *"
    },
    {
      "path": "/api/admin/jobs/run",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/admin/analytics/cleanup",
      "schedule": "45 2 * * *"
    }
  ]
}
