generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String                 @id @default(cuid())
  email                 String                 @unique
  name                  String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  emailVerified         DateTime?
  image                 String?
  phone                 String?
  role                  UserRole               @default(CUSTOMER)
  password              String?
  resetToken            String?
  resetTokenExpiry      DateTime?
  accounts              Account[]
  addresses             addresses[]
  orders                Order[]
  recentlyViewed        RecentlyViewed[]
  reviews               Review[]
  sessions              Session[]
  trainingRegistrations TrainingRegistration[]
  upi_payments          upi_payments[]
  wishlist              WishlistItem[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

model Category {
  id                 Int                 @id @default(autoincrement())
  title              String              @unique
  slug               String              @unique
  img                String
  path               String
  description        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  products           ProductCategory[]
  promotionalBanners PromotionalBanner[]

  @@map("categories")
}

model Product {
  id                 Int                   @id @default(autoincrement())
  title              String
  slug               String                @unique
  description        String
  price              Float
  measurementValue   Int
  measurementType    String
  inStock            Boolean               @default(true)
  featured           Boolean               @default(false)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  imgs               Json
  specifications     Json
  howToConsume       Json
  additionalInfo     Json
  benefits           Json?
  orderItems         OrderItem[]
  categories         ProductCategory[]
  discounts          ProductDiscount[]
  notifications      ProductNotification[]
  promotionalBanners PromotionalBanner[]
  recentlyViewed     RecentlyViewed[]
  reviews            Review[]
  wishlistItems      WishlistItem[]

  @@map("products")
}

model ProductCategory {
  id         Int      @id @default(autoincrement())
  productId  Int
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId])
  @@map("product_categories")
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  productId Int
  userId    String?
  comment   String?
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@map("reviews")
}

model Order {
  id                                            String         @id @default(cuid())
  orderNumber                                   String         @unique
  status                                        OrderStatus    @default(PENDING)
  total                                         Float
  subtotal                                      Float
  tax                                           Float          @default(0)
  shipping                                      Float          @default(0)
  createdAt                                     DateTime       @default(now())
  updatedAt                                     DateTime       @updatedAt
  customerName                                  String
  customerEmail                                 String
  customerPhone                                 String?
  shippingAddress                               Json // JSON object with address fields (UPDATED)
  userId                                        String?
  billingAddressId                              String?
  shippingAddressId                             String?
  invoice                                       Invoice?
  orderItems                                    OrderItem[]
  addresses_orders_billingAddressIdToaddresses  addresses?     @relation("orders_billingAddressIdToaddresses", fields: [billingAddressId], references: [id])
  addresses_orders_shippingAddressIdToaddresses addresses?     @relation("orders_shippingAddressIdToaddresses", fields: [shippingAddressId], references: [id])
  user                                          User?          @relation(fields: [userId], references: [id])
  upi_payments                                  upi_payments[]

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  quantity  Int
  price     Float
  orderId   String
  productId Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model WishlistItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

model RecentlyViewed {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("recently_viewed")
}

model BlogPost {
  id              Int      @id @default(autoincrement())
  title           String
  slug            String   @unique
  content         String
  excerpt         String?
  img             String
  views           Int      @default(0)
  published       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  metaTitle       String?
  metaDescription String?
  tags            Tag[]    @relation("BlogPostTags")

  @@map("blog_posts")
}

model News {
  id              Int      @id @default(autoincrement())
  title           String
  slug            String   @unique
  content         String
  excerpt         String?
  img             String
  views           Int      @default(0)
  published       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  metaTitle       String?
  metaDescription String?
  sourceUrl       String?
  source          String   @default("manual")
  tags            Tag[]    @relation("NewsTags")

  @@map("news")
}

model Tag {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  slug      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  posts     BlogPost[] @relation("BlogPostTags")
  news      News[]     @relation("NewsTags")

  @@map("tags")
}

model ProductNotification {
  id        String   @id @default(cuid())
  email     String
  productId Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([email, productId])
  @@map("product_notifications")
}

model ProductDiscount {
  id        Int          @id @default(autoincrement())
  productId Int
  type      DiscountType
  value     Float
  startDate DateTime     @default(now())
  endDate   DateTime?
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_discounts")
}

model PromotionalBanner {
  id          Int       @id @default(autoincrement())
  title       String
  subtitle    String?
  description String?
  discount    String?
  buttonText  String    @default("Buy Now")
  buttonLink  String?
  productId   Int?
  categoryId  Int?
  imageUrl    String
  bgColor     String    @default("#F5F5F7")
  textColor   String    @default("#000000")
  isActive    Boolean   @default(true)
  startDate   DateTime  @default(now())
  endDate     DateTime?
  priority    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  category    Category? @relation(fields: [categoryId], references: [id])
  product     Product?  @relation(fields: [productId], references: [id])

  @@map("promotional_banners")
}

model TrainingProgram {
  id                Int                    @id @default(autoincrement())
  name              String                 @unique
  slug              String                 @unique
  description       String
  price             Float
  duration          Int
  dailyHours        String                 @default("5-6 hours")
  type              TrainingType
  isActive          Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  hasEarlyBirdOffer Boolean                @default(false)
  earlyBirdPrice    Float?
  originalPrice     Float?
  earlyBirdEndDate  DateTime?
  registrations     TrainingRegistration[]
  schedules         TrainingSchedule[]

  @@map("training_programs")
}

model Instructor {
  id         Int                @id @default(autoincrement())
  name       String             @unique
  email      String?            @unique
  phone      String?
  bio        String?
  expertise  String?
  experience Int?
  isActive   Boolean            @default(true)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  schedules  TrainingSchedule[]

  @@map("instructors")
}

model TrainingSchedule {
  id                  Int             @id @default(autoincrement())
  trainingProgramId   Int
  dayNumber           Int
  date                DateTime
  title               String
  description         String
  topics              Json
  practicalSessions   Json
  theoreticalSessions Json
  learningObjectives  Json
  materials           Json
  startTime           String
  endTime             String
  isActive            Boolean         @default(true)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  instructorId        Int?
  instructor          Instructor?     @relation(fields: [instructorId], references: [id])
  trainingProgram     TrainingProgram @relation(fields: [trainingProgramId], references: [id], onDelete: Cascade)

  @@map("training_schedules")
}

model TrainingRegistration {
  id                  String             @id @default(cuid())
  registrationNumber  String             @unique
  status              RegistrationStatus @default(PENDING)
  participantName     String
  participantEmail    String
  participantPhone    String
  participantAddress  Json
  preferredStartDate  DateTime?
  specialRequirements String?
  totalAmount         Float
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  trainingProgramId   Int
  userId              String?
  trainingProgram     TrainingProgram    @relation(fields: [trainingProgramId], references: [id], onDelete: Cascade)
  user                User?              @relation(fields: [userId], references: [id])
  upi_payments        upi_payments[]

  @@map("training_registrations")
}

model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique
  status          InvoiceStatus @default(DRAFT)
  issuedAt        DateTime      @default(now())
  dueAt           DateTime?
  pdfPath         String?
  customerName    String?
  customerEmail   String?
  customerPhone   String?
  billingAddress  Json?
  shippingAddress Json?
  subtotal        Float?
  tax             Float?
  shipping        Float?
  total           Float?
  invoiceItems    Json?
  generatedAt     DateTime?
  emailSent       Boolean       @default(false)
  emailSentAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  orderId         String        @unique
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model addresses {
  id                                         String      @id
  street                                     String
  city                                       String
  state                                      String
  zip                                        String
  country                                    String
  type                                       AddressType
  isDefault                                  Boolean     @default(false)
  createdAt                                  DateTime    @default(now())
  updatedAt                                  DateTime
  userId                                     String
  users                                      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders_orders_billingAddressIdToaddresses  Order[]     @relation("orders_billingAddressIdToaddresses")
  orders_orders_shippingAddressIdToaddresses Order[]     @relation("orders_shippingAddressIdToaddresses")
}

model upi_payments {
  id                     String                @id
  amount                 Float
  status                 UpiPaymentStatus      @default(PENDING)
  resourceType           String
  transactionId          String?               @unique
  createdAt              DateTime              @default(now())
  updatedAt              DateTime
  orderId                String?
  trainingRegistrationId String?
  verifiedByUserId       String?
  orders                 Order?                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  training_registrations TrainingRegistration? @relation(fields: [trainingRegistrationId], references: [id], onDelete: Cascade)
  users                  User?                 @relation(fields: [verifiedByUserId], references: [id])
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum TrainingType {
  OYSTER
  BUTTON
  SHIITAKE
  GANODERMA
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  COMPLETED
}

enum AddressType {
  BILLING
  SHIPPING
  BOTH
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

enum UpiPaymentStatus {
  PENDING
  VERIFIED
  FAILED
}

model OTP {
  id        String   @id @default(cuid())
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
  @@map("otps")
}
