{
  "name": "next-commerce-community",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma migrate deploy && next build",
    "postbuild": "tsx scripts/create-otp-table.ts && tsx scripts/create-invoice-table.ts && tsx scripts/fix-invoice-table-columns.ts || echo 'Table setup completed'",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:blog": "tsx scripts/seed-blog-post.ts",
    "db:check:blog": "tsx scripts/check-blog-post.ts",
    "db:check:blog-data": "node scripts/check-production-blog-data.js",
    "api:check:production": "node scripts/check-production-api.js",
    "api:debug:curl": "bash scripts/debug-api-curl.sh",
    "db:test:blog-api": "tsx scripts/test-blog-api.ts",
    "db:studio": "prisma studio",
    "db:backup": "tsx scripts/backup-database.ts backup",
    "db:restore": "tsx scripts/backup-database.ts restore",
    "db:list": "tsx scripts/backup-database.ts list",
    "db:clean": "tsx scripts/backup-database.ts clean",
    "db:check:schema": "tsx scripts/check-production-schema.ts",
    "db:create:invoice-table": "tsx scripts/create-invoice-table.ts",
    "db:fix:invoice-table": "tsx scripts/fix-invoice-table-columns.ts",
    "test:order-flow": "tsx tests/order-invoice-flow.test.ts",
    "backup:production": "tsx scripts/backup-production-db.ts",
    "deploy:production": "./scripts/deploy-to-production.sh",
    "migrate:safe": "tsx scripts/safe-migrate.ts migrate",
    "migrate:reset": "tsx scripts/safe-migrate.ts reset",
    "migrate:status": "tsx scripts/safe-migrate.ts status",
    "fix:production-migration": "node scripts/resolve-production-migration.js",
    "fix:p3009": "node scripts/fix-p3009-production.js",
    "migrate:production": "tsx scripts/safe-production-migration.ts",
    "db:resolve-benefits": "tsx scripts/resolve-benefits-migration.ts",
    "db:force-resolve": "tsx scripts/force-resolve-migration.ts",
    "test:production-auth": "node test-production-auth.js",
    "deploy:clean": "./scripts/clean-deploy.sh",
    "run-blog-post-seed": "tsx scripts/seed-blog-post.ts",
    "fix:product-slugs": "tsx scripts/fix-product-slugs.ts",
    "add:early-bird-pricing": "tsx scripts/add-early-bird-pricing.ts",
    "check:early-bird-banners": "tsx scripts/check-early-bird-banners.ts",
    "seed:early-bird-banners": "tsx scripts/seed-early-bird-banners.ts",
    "seed:production-banners": "tsx scripts/seed-production-promotional-banners.ts",
    "test:promotional-banners-api": "tsx scripts/test-promotional-banners-api.ts",
    "test:api-direct": "tsx test-api-direct.ts",
    "verify:early-bird-pricing": "tsx scripts/verify-early-bird-pricing.ts",
    "test:admin-early-bird": "tsx scripts/test-admin-early-bird.ts",
    "resolve:instructorid-migration": "psql \"$DATABASE_URL\" -f scripts/resolve-instructorid-migration.sql",
    "scrape:mushroom-news": "tsx scripts/scrape-mushroom-news.ts",
    "scrape:mushroom-news:debug": "tsx scripts/scrape-mushroom-news.ts --debug",
    "test:checkout-flow": "tsx scripts/test-checkout-flow.ts",
    "test:invoice-system": "tsx scripts/test-invoice-system.ts",
    "fix:duplicate-addresses": "tsx scripts/fix-duplicate-addresses.ts",
    "fix:address-type-enum": "psql \"$DATABASE_URL\" -f scripts/fix-address-type-enum.sql",
    "create:otp-table": "tsx scripts/create-otp-table.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=__tests__/.*\\.test\\.tsx$",
    "test:integration": "jest --testPathPattern=integration",
    "test:checkout": "jest --testPathPattern=Checkout",
    "fix:order-status-enum": "tsx scripts/fix-order-status-enum.ts",
    "fix:production-order-status": "tsx scripts/fix-production-order-status.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^2.0.51",
    "@auth/prisma-adapter": "^2.10.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.15.0",
    "@reduxjs/toolkit": "^2.6.1",
    "@tailwindcss/typography": "^0.5.15",
    "@types/bcryptjs": "^2.4.6",
    "@types/nodemailer": "^7.0.1",
    "@vercel/blob": "^1.0.0",
    "ai": "^3.4.0",
    "autoprefixer": "10.4.15",
    "axios": "^1.4.1",
    "bcryptjs": "^3.0.2",
    "cheerio": "^1.0.0-rc.10",
    "dotenv": "^16.3.1",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.542.0",
    "next": "15.2.8",
    "next-auth": "^4.24.11",
    "node-cron": "^3.0.1",
    "nodemailer": "^6.10.1",
    "postcss": "8.4.29",
    "prisma": "^6.15.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-qr-code": "^2.0.18",
    "react-range-slider-input": "^3.0.7",
    "react-redux": "^9.2.0",
    "redux-persist": "^6.0.0",
    "swiper": "^10.2.0",
    "tailwindcss": "3.3.3",
    "tsx": "^4.20.5",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@swc/core": "^1.15.7",
    "@swc/jest": "^0.2.39",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/node": "20.6.2",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1",
    "axios": "^1.5.1",
    "eslint": "8.49.0",
    "eslint-config-next": "15.2.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "typescript": "5.2.2"
  }
}
